.5,"multistep/deis_3m","bong_tangent",2,-1,0.2,5,962683068204521,"randomize","standard",true],"color":"#332922","bgcolor":"#593930"},{"id":210,"type":"VAELoader","pos":[216.98169116067686,-102.73075815230733],"size":[225,108],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"vae_name","name":"vae_name","type":"COMBO","widget":{"name":"vae_name"},"link":null}],"outputs":[{"localized_name":"VAE","name":"VAE","type":"VAE","links":[1596]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.75","Node name for S&R":"VAELoader","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.4.1"}},"widgets_values":["qwen_image_vae.safetensors"],"color":"#223","bgcolor":"#335"},{"id":318,"type":"MarkdownNote","pos":[-967.9757410903477,-720.7405089724404],"size":[225,1798.09375],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"Models","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["## Main Model\n\nKrea 2 RAW.\n\n[Bf16 & FP8 versions](https://huggingface.co/Comfy-Org/Krea-2/tree/main/diffusion_models)\n\n[GGUF versions](https://huggingface.co/vantagewithai/Krea-2-Raw-GGUF/tree/main)\n\nUse the RAW model for this workflow, not the turbo model.\n\nGoes in models/diffusion_models\n\n## Turbo Lora\n\n[Rank 64 Turbo Lora](https://huggingface.co/Comfy-Org/Krea-2/blob/main/loras/krea2_turbo_lora_rank_64_bf16.safetensors)\n\nRequired when using the RAW model. Set it to 0.6 strength for this workflow.\n\nGoes in models/loras\n\n## Anti-Censorship Lora\n\n[2 Vector Bypass Lora](https://civitai.com/models/2728234/krea2filterbypass?modelVersionId=3066812)\n\nRequired if you want the model to work properly, even for SFW prompts. Set it to only 1.0 strength most of the time, but sometimes you may need to set it higher (2-6) if the model keeps refusing to do what you ask. This is a thing even for SFW prompts, especially when you want strong facial expressions.\n\nGoes in models/loras\n\n## Text Encoder\n\n[Qwen 3 VL 4B](https://huggingface.co/Comfy-Org/Krea-2/tree/main/text_encoders)\n\nUse BF16 if you can.\n\nGoes in models/text_encoders\n\n## VAE\n\n[Wan 2.1 FP32 VAE (RECOMMENDED)](https://huggingface.co/Kijai/WanVideo_comfy/blob/main/Wan2_1_VAE_fp32.safetensors)\n\nThe FP32 Wan VAE gives sharp results and has no downsides.\n\n\n[Wan 2.1 Upscale2x VAE (OPTIONAL)](https://huggingface.co/spacepxl/Wan2.1-VAE-upscale2x/blob/main/Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors)\n\nThis gives even sharper results than the regular Wan 2.1 FP32 VAE, but it also introduces noise & artifacts to the image.\n\nTo use it, you need the VAE-Utils Comfy node set installed so you can use the 'VAE Decode (VAE Utils)' node instead of the normal vae decoder. You also need to downscale your image by 0.5 afterwards (the VAE doubles the resolution).\n\n[Qwen Image VAE (OPTIONAL)](https://huggingface.co/Comfy-Org/Krea-2/tree/main/vae)\n\nThe qwen image VAE is the 'normal' one for Krea 2. It gives blurrier results than the Wan 2.1 FP32 VAE, but you may prefer it this way if you plan to post-process your images.\n\nGoes in models/vae"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":321,"type":"MarkdownNote","pos":[-362.13846542963904,-720.8229254479166],"size":[242.75,258.984375],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"Negative Prompts?","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["You can use negative prompts if you're using the RAW main model with the turbo lora.\n\nTo do this, you need to set the CFG to ~2.0 strength. This will 'enable' CFG which makes negative prompts work, but be aware that this will **double** the time it takes to generate an image."],"color":"#2a363b","bgcolor":"#3f5159"},{"id":282,"type":"PrimitiveFloat","pos":[669.8324808667198,392.69492638128935],"size":[225,80],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"FLOAT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"FLOAT","name":"FLOAT","type":"FLOAT","links":[1764,1765]}],"title":"CFG","properties":{"cnr_id":"comfy-core","ver":"0.12.3","Node name for S&R":"PrimitiveFloat"},"widgets_values":[1],"color":"#2a363b","bgcolor":"#3f5159"},{"id":319,"type":"MarkdownNote","pos":[622.7807276689574,-455.11965751931314],"size":[240.734375,495.5625],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"Important Loras","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["**TURBO LORA**\n\nUse the raw main model, and always leave the turbo lora on at 0.6 strength.\n\n**2 VECTOR FILTER BYPASS LORA**\n\nSet it to 1.0 strength for most things. Leave it on even when you're using NSFW loras (but don't go higher than 1.0 then).\n\nIt will degrade image quality past 1.0 strength, which is why you usually don't want to go higher.\n\nYou can also use NSFW loras to improve prompt adherence *even for SFW prompts*.\n\nNew finetunes and loras will probably help in the future."],"color":"#2a363b","bgcolor":"#3f5159"},{"id":276,"type":"Seed (rgthree)","pos":[670.5231002834112,209.37456391874107],"size":[225,188],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[{"dir":4,"name":"SEED","shape":3,"type":"INT","links":[1744,1755]}],"properties":{"cnr_id":"rgthree-comfy","ver":"8ff50e4521881eca1fe26aec9615fc9362474931","randomMax":1125899906842624,"randomMin":0},"widgets_values":[-1,"","",""],"color":"#2a363b","bgcolor":"#3f5159"},{"id":271,"type":"PrimitiveStringMultiline","pos":[7.054503423904256,299.2392718357335],"size":[484.625,116],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":[1739]}],"title":"Negative","properties":{"cnr_id":"comfy-core","ver":"0.3.75","